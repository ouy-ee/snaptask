{
  "name": "snaptask",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "SnapTask — AI 截图任务助手(React 前端 + Node 后端,后端离线时自动回退本地 Demo)",
  "scripts": {
    "dev": "vite",
