# ============ 基础 ============
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
# 数据目录(数据库 + 本地文件存储)
DATA_DIR=./data
# 允许的前端来源(生产改为你的域名,逗号分隔多个)
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ============ 鉴权 ============
# 生产环境必填!生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# access 令牌有效期(秒),默认 900(15 分钟)
JWT_ACCESS_TTL=900
# refresh 令牌有效期(天),默认 30
JWT_REFRESH_TTL_DAYS=30
# 图片签名 URL 有效期(秒),默认 86400(24 小时)。<img> 标签无法带 Bearer 头,靠短时签名鉴权
IMAGE_URL_TTL=86400

# ============ 限流 ============
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ============ 文件存储 ============
# local = 服务器本地磁盘(免费) | s3 = S3 兼容对象存储(Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
MAX_UPLOAD_BYTES=10485760

# STORAGE_DRIVER=s3 时填写(R2 示例:endpoint https://<account>.r2.cloudflarestorage.com, forcePathStyle=true)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# 预签名 URL 有效期(秒)
S3_PRESIGN_TTL=900

# ============ OCR ============
# none = 不做 OCR(视觉模型直接读图) | baidu = 百度 OCR | paddle = 自托管 PaddleOCR
OCR_PROVIDER=paddle
# 百度 OCR(通用文字识别-高精度)。每月免费额度以官网为准,见 docs/COSTS.md
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
# 自托管 PaddleOCR 服务地址(server/ocr/ 提供部署脚本)
PADDLE_OCR_URL=http://localhost:8788
# 每日 OCR 调用上限(防超支)
OCR_DAILY_LIMIT=500

# ============ 视觉理解模型 ============
# zhipu = 智谱 GLM-4V-Flash(撰写时免费,部署前到官网核实) | siliconflow | ollama | openai
VISION_PROVIDER=zhipu
# 必填:智谱 API Key(open.bigmodel.cn 控制台获取)。
# 未配置/留占位符 → 后端拒绝启动(启动即拦截);Ollama 本地模型无需 Key。
# ⚠️ 真实 Key 只放 server/.env(已被 .gitignore 排除),绝不写进本模板文件
VISION_API_KEY=your_api_key_here
# 各 Provider 默认值(不填用默认):
#   zhipu:      base https://open.bigmodel.cn/api/paas/v4   model glm-4v-flash
#   siliconflow:base https://api.siliconflow.cn/v1          model Qwen/Qwen2.5-VL-72B-Instruct
#   ollama:     base http://localhost:11434/v1              model qwen2.5vl:7b
#   openai:     base https://api.openai.com/v1              model gpt-4o-mini
VISION_BASE_URL=
VISION_MODEL=
# 单次调用超时(毫秒)
VISION_TIMEOUT_MS=120000
# 每日视觉调用上限(防超支)
VISION_DAILY_LIMIT=100
# 单次输出最大 tokens。GLM-4V-Flash 上限为 [1,1024],超出会报「max_tokens参数非法」;
# 换用上限更高的模型(如 GLM-4V-Plus)时可调大。
VISION_MAX_TOKENS=1024

# ============ 业务 ============
# 部署在 nginx 等反向代理之后时设为 true(限流按真实 IP 计数)
TRUST_PROXY=false
# 回收站保留天数(到期自动彻底删除)
RECYCLE_RETENTION_DAYS=30
# 分析并发(1 = 同时只跑一个分析,控制模型成本与限流)
ANALYSIS_CONCURRENCY=1
# 孤儿上传清理:超过该小时数未被任何记录引用的上传将被删除
ORPHAN_UPLOAD_TTL_HOURS=24
